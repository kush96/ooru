# Add these entries to your existing .env; do not replace its database settings.
GROQ_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_JSON_MODE=json_schema
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=2048

# Keep your existing DATABASE_URL (needed by data import/map scripts, not chat).
# DATABASE_URL=postgresql+psycopg://user:password@localhost:55432/database

# Optional self-hosted OpenAI-compatible server (no Groq key is sent to it):
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=your-local-model-name
# LLM_API_KEY=your-server-key-if-required
# LLM_JSON_MODE=json_object  # only if the server lacks json_schema support
